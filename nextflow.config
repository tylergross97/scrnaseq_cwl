/*
 * Nextflow config for the mock scRNA-seq (STARsolo) pipeline
 * Converted from scrnaseq.cwl
 */

params {
    // Input / references
    input      = null
    fasta      = null
    gtf        = null
    whitelist  = null            // optional; falls back to `--soloCBwhitelist None`

    // Single-cell chemistry (10x v2 defaults; from CWL cb=16, and v2 umi=10)
    protocol   = '10XV2'
    cb_len     = 16
    umi_len    = 10

    // STAR index build tuning (reduce for small genomes)
    star_genomeSAindexNbases = 14

    // Output
    outdir     = 'results'
    publish_dir_mode = 'copy'
}

// Per-label resources
process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: params.publish_dir_mode,
    ]

    withLabel: process_single { cpus = 1; memory = '4.GB';  time = '2.h' }
    withLabel: process_medium { cpus = 2; memory = '8.GB';  time = '4.h' }
    withLabel: process_high   { cpus = 4; memory = '14.GB'; time = '8.h' }
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    wave {
        wave.enabled = true
        wave.strategy = 'container'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

manifest {
    name            = 'scrnaseq-star-nf'
    description      = 'Mock single-cell RNA-seq pipeline (STARsolo), converted from CWL'
    author          = 'Converted with Seqera Co-Scientist'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}
