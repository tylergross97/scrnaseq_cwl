// scrnaseq — Nextflow configuration

plugins {
    id 'nf-schema@2.1.1'
}

params {
    // Input / output
    input       = null
    outdir      = 'results'

    // Reference data
    genome_dir  = null
    whitelist   = null

    // STARsolo tool knobs
    cb_length   = 16
    umi_length  = 12
}

// Resource labels
process {
    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
    }
    withLabel: 'process_high' {
        cpus   = 8
        memory = 32.GB
    }
}

profiles {
    docker {
        docker.enabled = true
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
    }
    test {
        params.input      = "${projectDir}/assets/samplesheet.csv"
        params.genome_dir = "${projectDir}/tests/data/star_index"
        params.whitelist  = "${projectDir}/tests/data/737K-august-2016.txt"
    }
}

manifest {
    name            = 'scrnaseq'
    author          = 'Tyler Gross'
    description     = 'Mock single-cell RNA-seq pipeline (STARsolo) — Nextflow port of scrnaseq_cwl'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '1.0.0'
}

includeConfig 'conf/modules.config'
