// Nextflow port of scrnaseq_cwl

plugins {
    id 'nf-schema@2.1.1'
}

manifest {
    name            = 'scrnaseq_cwl'
    author          = 'Tyler Gross'
    description      = 'Nextflow port of the scrnaseq_cwl STARsolo single-cell RNA-seq pipeline'
    homePage        = 'https://github.com/tylergross97/scrnaseq_cwl'
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
    // Relative path (from the project root) to the pipeline metro-map diagram
    diagram         = 'docs/images/metro-map.svg'
}

params {
    // Input / output
    input       = null   // samplesheet CSV: sample,fastq_1,fastq_2
    outdir      = 'results'

    // Reference data (global inputs)
    star_index  = null   // pre-built STAR genome index directory (skips index build)
    fasta       = null   // genome FASTA — used to build the index when star_index is not set
    gtf         = null   // gene annotation GTF — used to build the index when star_index is not set
    whitelist   = null   // cell barcode whitelist (optional; STARsolo uses 'None' when unset)

    // STARsolo tool arguments (surfaced from the CWL defaults)
    cb_length            = 16   // --soloCBlen
    umi_length           = 12   // --soloUMIlen (10 for 10x V2, 12 for 10x V3)
    genome_saindex_nbases = 14  // STAR --genomeSAindexNbases (lower for small genomes)
}

profiles {
    docker {
        docker.enabled = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
    }
    wave {
        wave.enabled = true
        wave.strategy = ['conda', 'container']
    }
    test {
        // nf-core/scrnaseq minimal test dataset (10x Genomics V2: CB=16, UMI=10)
        params.input      = 'https://github.com/nf-core/test-datasets/raw/scrnaseq/samplesheet-2-0.csv'
        params.fasta      = 'https://github.com/nf-core/test-datasets/raw/scrnaseq/reference/GRCm38.p6.genome.chr19.fa'
        params.gtf        = 'https://github.com/nf-core/test-datasets/raw/scrnaseq/reference/gencode.vM19.annotation.chr19.gtf'
        params.whitelist  = null   // let STARsolo run without a predefined whitelist on the test data
        params.cb_length  = 16
        params.umi_length = 10     // 10x V2
        params.genome_saindex_nbases = 11   // small (chr19-only) test genome

        process.resourceLimits = [ cpus: 4, memory: 15.GB, time: 1.h ]
    }
}

includeConfig 'conf/modules.config'
