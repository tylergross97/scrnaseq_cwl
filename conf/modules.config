// Per-process configuration: resources, published outputs, and tool arguments.

process {
    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':').last().toLowerCase()}" },
        mode: 'copy'
    ]

    withLabel: 'process_low' {
        cpus   = 2
        memory = 4.GB
    }

    withLabel: 'process_high' {
        cpus   = 8
        memory = 32.GB
    }

    withName: 'STAR_GENOMEGENERATE' {
        // genomeSAindexNbases must be lowered for small genomes (e.g. the test data)
        ext.args = { "--genomeSAindexNbases ${params.genome_saindex_nbases}" }
    }

    withName: 'STARSOLO' {
        // Surface cb/umi lengths as pipeline params, plumbed via ext.args
        ext.args = { "--soloCBlen ${params.cb_length} --soloUMIlen ${params.umi_length}" }
    }
}
