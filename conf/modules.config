// Per-module tool arguments. Modules read these via task.ext.args rather
// than reading params directly.

process {
    withName: 'STAR_SOLO' {
        // Cell-barcode and UMI lengths (10x v2 defaults: 16 / 10, CWL used 16 / 12)
        ext.args = { "--soloCBlen ${params.cb_length} --soloUMIlen ${params.umi_length}" }
    }
}
